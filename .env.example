# ──────────────────────────────────────────────────────────────────────────
# FrankenData environment variables (EXAMPLE — placeholders only)
#
# Copy this file to `.env` (which is gitignored) and fill in real values for
# local experimentation, OR set these in your Vercel project settings for
# production. NEVER commit real secrets. This file ships only placeholders.
#
# IMPORTANT: The app is fully functional WITHOUT any of these. With
# `VITE_AI_ENABLED` unset or "false" (the default), FrankenData runs the
# deterministic, offline rules engine only — no network AI call is ever made.
# The variables below are needed ONLY to turn the optional LLM match-refinement
# enhancement on. If the proxy is misconfigured or unreachable, the client
# silently falls back to the rules engine.
# ──────────────────────────────────────────────────────────────────────────


# ── Client-side feature flag (build-time, Vite) ─────────────────────────────
# The ONLY client-visible variable (the `VITE_` prefix exposes it to the
# browser bundle). When it is exactly the string "true", the app will attempt
# the optional AI refinement via the `/api/ai` proxy. Anything else — unset,
# "false", or any other value — means rules-only mode with NO network attempt.
# Default for a safe, offline build: leave unset or "false".
VITE_AI_ENABLED=false


# ── Server-side only (the `/api/ai` serverless function) ────────────────────
# None of the variables below are exposed to the browser. They are read by the
# serverless proxy at runtime (see api/ai.ts) and must be configured as Vercel
# environment variables in production. The LLM API key NEVER reaches the client.

# Which LLM provider the proxy talks to. Required to enable AI. e.g. "openai".
AI_PROVIDER=openai

# The model id. Required to enable AI — there is no hard-coded default; the
# model is fully env-driven. e.g. "gpt-4o-mini".
AI_MODEL=your-model-id-here

# The LLM provider API key, read server-side only and never shipped to the
# client. The proxy reads OPENAI_API_KEY first, then falls back to AI_API_KEY.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the OpenAI-compatible base URL (for non-OpenAI providers
# that speak the same Chat Completions shape). Defaults to the OpenAI endpoint
# when unset. e.g. "https://api.openai.com/v1".
# AI_BASE_URL=https://api.openai.com/v1

# Upstash Redis REST credentials for rate limiting + the global daily cap.
# Provision via the Vercel Marketplace (it can inject these automatically).
# If missing/unreachable, the proxy fails closed (no LLM call) and the client
# falls back to the rules engine.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# Secret salt used to hash the client IP for the per-client rate-limit key.
# The raw IP is never stored. Use a long random string; a missing salt makes
# the proxy fail closed. Change this to your own random value.
IP_HASH_SALT=change-me-random-string

# Optional: comma-separated allow-list of origins for the proxy's courtesy
# Origin check. When unset or empty, the check is skipped (all origins
# allowed) — it is a courtesy, not a security boundary.
# ALLOWED_ORIGINS=https://your-app.vercel.app
